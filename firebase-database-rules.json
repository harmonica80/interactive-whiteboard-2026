{
  "rules": {
    /* 根目錄：允許讀取，但禁止直接抹除整庫根節點 */
    ".read": true,
    ".write": false,

    /* 1. 💬 提問區防護與欄位限制 */
    "questions": {
      ".read": true,
      "$questionId": {
        ".write": "newData.exists() || !data.exists()",
        ".validate": "newData.hasChildren(['content', 'timestamp'])",
        "content": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "likes": {
          ".validate": "newData.isNumber()"
        },
        "completed": {
          ".validate": "newData.isBoolean()"
        },
        "commentsCount": {
          ".validate": "newData.isNumber()"
        },
        "comments": {
          "$commentId": {
            ".write": "newData.exists() || !data.exists()",
            ".validate": "newData.hasChildren(['content', 'timestamp'])",
            "content": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "author": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },

    /* 2. 🖼️ 圖片分享區限制 */
    "images": {
      ".read": true,
      "$imageId": {
        ".write": "newData.exists() || !data.exists()",
        ".validate": "newData.hasChildren(['url', 'timestamp'])",
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "folder": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "commentsCount": {
          ".validate": "newData.isNumber()"
        },
        "comments": {
          "$commentId": {
            ".write": "newData.exists() || !data.exists()",
            ".validate": "newData.hasChildren(['content', 'timestamp'])",
            "content": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            }
          }
        }
      }
    },

    /* 3. 🎥 影片分享區限制 */
    "videos": {
      ".read": true,
      "$videoId": {
        ".write": "newData.exists() || !data.exists()",
        ".validate": "newData.hasChildren(['url', 'timestamp'])",
        "url": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "folder": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "commentsCount": {
          ".validate": "newData.isNumber()"
        },
        "comments": {
          "$commentId": {
            ".write": "newData.exists() || !data.exists()",
            ".validate": "newData.hasChildren(['content', 'timestamp'])",
            "content": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            }
          }
        }
      }
    },

    /* 4. 📢 教師分享區 */
    "shares": {
      ".read": true,
      "$shareId": {
        ".write": "newData.exists() || !data.exists()",
        ".validate": "newData.hasChildren(['timestamp'])"
      }
    },

    /* 5. 📝 測驗與歷屆題目庫 (安全驗證防護) */
    "quiz": {
      ".read": true,
      "current": {
        ".write": "newData.exists() || !data.exists()"
      },
      "answers": {
        "$answerId": {
          ".write": "newData.exists() || !data.exists()"
        }
      },
      "history": {
        "$historyId": {
          ".write": "newData.exists() || !data.exists()"
        }
      },
      "timer": {
        ".write": "newData.exists() || !data.exists()"
      }
    },

    /* 6. 🎮 專注力與搶答遊戲 (安全驗證防護) */
    "focus_game": {
      ".read": true,
      ".write": "newData.exists() || !data.exists()"
    },
    "buzz_game": {
      ".read": true,
      ".write": "newData.exists() || !data.exists()"
    },

    /* 7. 👥 在線人數統計 (安全驗證防護) */
    "online_users": {
      ".read": true,
      "$userKey": {
        ".write": "newData.exists() || !data.exists()"
      }
    }
  }
}
